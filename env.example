# ==============================================================================
# cnn_metagenome - Configuração de Variáveis de Ambiente (AD-017)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Modo de Execução do Servidor Remoto (JupyterHub / Cluster)
# ------------------------------------------------------------------------------
# Quando 'true' (ou qualquer valor diferente de 'False'/'0'), o runtime executa
# em modo servidor remoto: detecta automaticamente o diretório de dados do servidor
# (/home/mlima/workspace) e roda a inferência completa com os modelos treinados.
#
# Em máquinas de desenvolvimento local ou CI, defina como 'False' para executar
# os testes com mini-lotes sintéticos rápidos em CPU sem precisar baixar arquivos gigabyte.
REMOTE_SERVER=true
# remote_server=true   # Também suportado em letras minúsculas

# ------------------------------------------------------------------------------
# 2. Raiz dos Dados e Checkpoints (DATA_ROOT)
# ------------------------------------------------------------------------------
# Caminho base que contém as pastas:
#   - cnn_kraken/ (processed_kraken_species_splited_parquet/, checkpoints/)
#   - cnn_kraken_species/ (checkpoints/)
#   - cnn_kraken_genus/ (checkpoints/)
#   - dataset_kraken/ (species_name_ids.csv)
#
# No servidor remoto JupyterHub padrão:
DATA_ROOT=/home/mlima/workspace
# Em armazenamento de rede customizado (exemplo):
# DATA_ROOT=/data/metagenome

# ------------------------------------------------------------------------------
# 3. Modo Smoke Test (SMOKE_TEST)
# ------------------------------------------------------------------------------
# 0 = Execução real completa (N=1.706.270 amostras, 256 partições Parquet)
# 1 = Teste rápido de fumaça (16 amostras sintéticas determinísticas)
# Padrão: 0 quando no servidor remoto, 1 em ambiente de testes locais.
SMOKE_TEST=0

# ------------------------------------------------------------------------------
# 4. Rastreabilidade e Log de Caminhos (LOG_PATH)
# ------------------------------------------------------------------------------
# true  = Imprime [LOG_PATH] no console a cada carregamento de DataLoader,
#         Dataset Parquet, mapeamento taxonômico e checkpoint .pt de modelo.
# false = Desativa o log de caminhos.
LOG_PATH=true

# ------------------------------------------------------------------------------
# 5. Configurações de GPU e CUDA
# ------------------------------------------------------------------------------
# Dispositivo GPU padrão (0, 1, etc.)
# CUDA_VISIBLE_DEVICES=0

